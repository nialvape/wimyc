# ─── Kapso (WhatsApp Cloud API proxy) ─────────────────────────────────────────
# Phone Number ID de WhatsApp Business
PHONE_NUMBER_ID=
# Base del proxy meta-compatible de Kapso
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp
# API key del proyecto en Kapso (se manda como header X-API-Key).
# Necesaria para ENVIAR mensajes y para DESCARGAR el audio de las notas de voz.
KAPSO_API_KEY=
# Secret del webhook (Integrations -> Webhooks -> Platform). Firma HMAC-SHA256.
KAPSO_WEBHOOK_SECRET=

# ─── Acceso ───────────────────────────────────────────────────────────────────
# Contraseña compartida. Un número desconocido tiene que mandarla como primer
# mensaje; después queda registrado y no se le vuelve a pedir.
ACCESS_PASSWORD=

# ─── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# Modelo de speech-to-text (Whisper)
GROQ_STT_MODEL=whisper-large-v3-turbo
# Modelo de lenguaje que interpreta el mensaje
GROQ_LLM=

# ─── OpenRouter (fallback del LLM) ────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
DATABASE_PATH=./data/wimyc.db
DEFAULT_TZ=America/Argentina/Buenos_Aires
PUBLIC_BASE_URL=https://wimyc.sopia.app
